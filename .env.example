# Leave unset to reuse lark-openapi-mcp/.env locally.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_DOMAIN=https://open.larksuite.com
LARK_SPREADSHEET_TOKEN=
ADSIGHT_AUTOLOAD_DEFAULT=false

# Optional persistent path for shared development notes. Default: data/notes.sqlite3
# ADSIGHT_NOTES_DB=/persistent/notes.sqlite3

# AI providers. Keep real keys in .env only; never put them in browser code.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
